# ⚠️ En production : APP_ENV=production, APP_DEBUG=false (brief §18 — ne
# jamais divulguer de stack trace), APP_URL en https://, et
# SESSION_SECURE_COOKIE=true (voir plus bas).
APP_NAME=ToulouseWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toulouseweb
DB_USERNAME=root
DB_PASSWORD=

# Connexion en lecture seule vers l'ancienne base, utilisée uniquement par les
# commandes artisan migrate:* (voir TECHNICAL_DOCUMENTATION.md §10). À retirer
# une fois la migration de production terminée.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=toulouseweb_old
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# ⚠️ À mettre à true en production (HTTPS) pour empêcher l'envoi du cookie
# de session en clair — laissé vide/false uniquement pour le dev local HTTP.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Purge automatique du cache Cloudflare à chaque ajout/modif/suppression de
# contenu public (demande client, voir TECHNICAL_DOCUMENTATION.md §17 et
# App\Services\Cache\CloudflareCachePurger). Désactivée tant que
# CLOUDFLARE_CACHE_PURGE_ENABLED n'est pas explicitement à true (jamais en
# local/dev/test) — Zone ID et API Token à créer dans le dashboard
# Cloudflare (Mon profil > Jetons API > "Modifier le cache Cloudflare",
# scope Zone.Cache Purge en lecture/écriture, restreint à la zone du site).
CLOUDFLARE_CACHE_PURGE_ENABLED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Demande d'indexation automatique Google Search Console à chaque ajout/
# modif/suppression de contenu (demande client, voir
# TECHNICAL_DOCUMENTATION.md §20 et App\Services\Seo\GoogleIndexingService).
# Désactivée tant que GOOGLE_INDEXING_ENABLED n'est pas explicitement à true
# (jamais en local/dev/test). GOOGLE_INDEXING_CREDENTIALS_JSON_BASE64 :
# contenu du fichier JSON de clé de compte de service Google Cloud (API
# "Web Search Indexing" activée, compte ajouté comme propriétaire de la
# propriété dans Search Console), encodé en base64 sur une seule ligne
# (`base64 -w0 service-account.json`) pour éviter les problèmes de retours
# à la ligne dans un fichier .env.
GOOGLE_INDEXING_ENABLED=false
GOOGLE_INDEXING_CREDENTIALS_JSON_BASE64=
GOOGLE_INDEXING_DAILY_QUOTA=200

VITE_APP_NAME="${APP_NAME}"
