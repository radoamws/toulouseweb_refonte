<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Défense en profondeur : la purge Cloudflare est déjà désactivée
        par défaut (config/services.php) tant que CLOUDFLARE_ZONE_ID/
        CLOUDFLARE_API_TOKEN ne sont pas renseignés, mais forcer explicitement
        false ici garantit qu'aucun test ne tente un vrai appel HTTP sortant,
        même si une future config locale renseignait ces clés par erreur. -->
        <env name="CLOUDFLARE_CACHE_PURGE_ENABLED" value="false"/>
        <env name="GOOGLE_INDEXING_ENABLED" value="false"/>
        <!-- Même remarque que ci-dessus pour reCAPTCHA (App\Rules\Recaptcha) :
        vide ici garantit le comportement fail-open dans toute la suite, même
        si le .env LOCAL renseigne de vraies clés (ce qui a fait échouer 21
        tests le 21/09/2026, juste après l'ajout des clés en local — la
        règle exigeait alors le champ recaptcha_token pour TOUS les
        formulaires testés, pas seulement RecaptchaTest, qui configure
        explicitement une clé pour ses propres cas). -->
        <env name="RECAPTCHA_SITE_KEY" value=""/>
        <env name="RECAPTCHA_SECRET_KEY" value=""/>
        <!-- Valeur fixe connue des tests uniquement (voir WebCronTest) — pas un
        vrai secret, jamais utilisée hors de cet environnement de test. -->
        <env name="WEBCRON_SECRET" value="test-webcron-secret-value"/>
        <!-- Adresse fictive pour tester l'envoi des notifications admin
        (Mail::fake() dans les tests concernés — aucun email réel n'est
        jamais envoyé pendant la suite de tests). -->
        <env name="ADMIN_NOTIFICATION_EMAILS" value="admin-test@example.com"/>
        <!-- Défense en profondeur (même logique que CLOUDFLARE_CACHE_PURGE_ENABLED
        ci-dessus) : aucun test ne doit pouvoir déclencher un envoi à TOUS les
        abonnés, même par erreur — voir App\Services\Newsletter\NewsletterSender. -->
        <env name="NEWSLETTER_SENDING_ENABLED" value="false"/>
        <env name="NEWSLETTER_TEST_RECIPIENTS" value="newsletter-test@example.com"/>
        <!-- Valeur fictive (voir App\Mail\Transport\BrevoApiTransport) — un vrai
        envoi est toujours intercepté par Http::fake() dans les tests concernés,
        jamais un appel réseau réel. Sans cette valeur ici, `.env.example` +
        key:generate (utilisé par le CI/CD, voir .github/workflows/deploy.yml)
        laisse BREVO_API_KEY absent — a fait échouer le déploiement le
        14/09/2026 (TypeError, voir TECHNICAL_DOCUMENTATION.md §40) alors que
        la suite passait en local (vraie clé présente dans le .env local). -->
        <env name="BREVO_API_KEY" value="test-fake-brevo-key"/>
        <env name="BREVO_SENDER_EMAIL" value="contact@example.com"/>
        <env name="BREVO_SENDER_NAME" value="ToulouseWeb Test"/>
    </php>
</phpunit>
